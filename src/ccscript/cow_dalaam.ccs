command e(label) "{long label}"

// ==============================================================================
// EarthBound: Zero Fault - Phase 10: Dalaam & Mu Resource Reclamation
// ==============================================================================
// Progressive sensory register deallocation, Mu null-state attainment,
// and Prince Poo Thread 4 registration.
// ==============================================================================

cow_mu_trial_legs:
    "{window_open(1)}@Prince {name(4)}..." next
    "@I am the ancestral compiler spirit." next
    "@To complete your compilation trial,{pause(15)} I will deallocate your locomotive registers <legs>." next
    "@You will forfeit all movement execution capability." next
    "@Do you accept this resource reclamation?" linebreak
    "[19 02]Yes[02] [19 02]No[02][1C 07 02][11]{clearline}[09 02 {e(cow_mu_trial_legs_accept)} {e(data_46.l_0xc925d0)}]"
    goto(data_46.l_0xc925d0)

cow_mu_trial_legs_accept:
    call(data_46.l_0xc92909)
    "{window_closetop}"
    eob

cow_mu_trial_arms:
    "{window_open(1)}@Prince {name(4)}..." next
    "@Locomotive registers reclaimed. You can no longer traverse addresses." next
    "@Next, I will sever your peripheral I/O vectors <arms>..." next
    "@Reclaiming your peripheral I/O vectors..." next
    "@Do you accept this resource reclamation?" linebreak
    "[19 02]Yes[02] [19 02]No[02][1C 07 02][11]{clearline}[09 02 {e(cow_mu_trial_arms_accept)} {e(data_46.l_0xc925d0)}]"
    goto(data_46.l_0xc925d0)

cow_mu_trial_arms_accept:
    call(data_46.l_0xc92924)
    "{window_closetop}"
    eob

cow_mu_trial_ears:
    "{window_open(1)}@Prince {name(4)}..." next
    "@Deprived of locomotive registers and I/O vectors, your thread sits idle." next
    "@Now I will disconnect your input event stream <ears>." next
    "@Do you accept silencing all incoming interrupts?" linebreak
    "[19 02]Yes[02] [19 02]No[02][1C 07 02][11]{clearline}[09 02 {e(cow_mu_trial_ears_accept)} {e(data_46.l_0xc925d0)}]"
    goto(data_46.l_0xc925d0)

cow_mu_trial_ears_accept:
    call(data_46.l_0xc9293f)
    "{window_closetop}"
    eob

cow_mu_trial_eyes:
    "{text_blips(3)}{window_open(1)}@(Prince {name(4)}..." next
    "@No motion, no I/O, no incoming events..." next
    "@Direct memory bus transmission...{pause(15)} I must ask you:" next
    "@Shall I disable your visual framebuffer <eyes>?" next
    "@Do you accept execution in absolute null darkness?)" linebreak
    "[19 02]Yes[02] [19 02]No[02][1C 07 02][11]{clearline}[09 02 {e(cow_mu_trial_eyes_accept)} {e(data_46.l_0xc925d0)}]"
    goto(data_46.l_0xc925d0)

cow_mu_trial_eyes_accept:
    call(data_46.l_0xc92955)
    "{window_closetop}"
    eob

cow_mu_trial_mind:
    "{window_open(1)}@(Prince {name(4)}..." next
    "@Only your core execution thread and registers <mind> remain allocated." next
    "@In this final phase, I will purge your thread memory completely into the null state." next
    "@You will hold zero references, zero state, and zero attachments." next
    "@Do you accept total deallocation?" next
    "@Purging execution context... Total memory reclamation complete!)[03]{pause(20)}{window_closeall}"
    call(cow_engine.cow_fault_commit_mu)
    "{set(flag 901)}{set(flag 273)}{heal_percent(4, 100)}{text_blips(1)}{set(flag 595)}"
    eob

cow_master_dalaam:
    "[06 49 00 {e(data_53.l_0xc9cbc4)}][06 10 00 {e(data_53.l_0xc9cb79)}][06 11 01 {e(cow_master_conclude)}][06 0A 00 {e(data_53.l_0xc9c9db)}]"
    "@I will not transmit further instructions." next
    "@Return to <Mu,> the place of total resource reclamation.{wait}"
    call(data_46.l_0xc92458)
    eob

cow_master_conclude:
    "@I am proud." next
    "@You have completed your Mu resource deallocation." next
    "@There is nothing more to compile from the ancient scriptures.{wait}{window_closetop}"
    call(data_33.l_0xc7dd6b)
    "{music(119)}{pause(60)}{window_open(1)}@Prince {name(4)}," next
    "@A critical kernel exception threatens the global architecture." next
    "@The anomaly can only be halted by four synchronized parallel threads." next
    "@Thread {name(1)} is the primary coordinator." next
    "@You are assigned to Thread 4, Prince {name(4)}." next
    "@Now that resource reclamation is complete, link with Thread {name(1)} at once!" next
    "@Synchronize the four execution threads for the system's survival!{wait}{window_closeall}{pause(1)}{window_open(14)}[1E 09 04 70 17 00]" linebreak
    "{prompt}{window_closeall}"
    call(cow_engine.cow_fault_commit_dalaam)
    "{set(flag 902)}"
    goto(data_46.l_0xc9237e)
