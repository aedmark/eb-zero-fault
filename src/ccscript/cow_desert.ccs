command e(label) "{long label}"

// ==============================================================================
// EarthBound: Zero Fault - Phase 9: Dusty Dunes Desert Scenario
// ==============================================================================
// Sparse array compaction, Guardian Digger defrag routines, and PSI Teleport
// virtual memory page translation training.
// ==============================================================================

cow_miner_george:
    "[06 79 03 {e(cow_miner_george_dirtied)}]"
    call(cow_engine.cow_fault_commit_desert)
    "{set(flag 889)}"
    "@I was attempting to defragment this sparse memory sector...{pause(20)} but encountered a dense maze of unallocated pages!" next
    "@Five rogue defragmentation subroutines have partitioned the sector!" next
    "@They are all claiming the same index... five Guardian Diggers!" next
    "@If you terminate those runaway threads, I can compact the memory bus and open the route forward." next
    "@My process monitor is spiking from thread contention!" end

cow_miner_george_dirtied:
    "@Please collect those five rogue defragmentation subroutines." next
    "@Until they are garbage collected, this sparse array cannot be compacted!" end

cow_guardian_digger_msg:
    "{music(155)}"
    "{window_open(1)}@I am Sparse Defrag Digger #3 of this fragmented sector!" next
    "@There are five duplicate worker threads allocated here,{pause(15)} all sharing the same index register!" next
    "@My execution priority is strictly equidistant between rank 2 and rank 4!" next
    "@Prepare for thread collision![03]{window_closeall}" eob

cow_guardian_digger_1:
    "[06 15 01 {e(data_32.l_0xc7c588)}]"
    call(cow_guardian_digger_msg)
    call(data_21.l_0xc6858a)
    "[1B 03 {e(data_21.l_0xc683de)}]"
    call(data_16.l_0xc615e9)
    "{pause(1)}[1F F1 3F 03 7B 02]{set(flag 277)}"
    call(data_16.l_0xc615a7)
    eob

