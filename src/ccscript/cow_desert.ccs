cow_teleport_monkey:
    "[06 13 01 {e(data_17.l_0xc62b6f)}]{counter(1)}"
    call(data_33.l_0xc7dc7f)
    "[1B 03 {e(data_17.l_0xc62a9b)}][06 02 00 {e(data_17.l_0xc62a30)}]"
    goto(cow_teleport_monkey_demo)

cow_teleport_monkey_demo:
    "@Kyakyakya!{pause(15)} Thread {name(1)}!" next
    "@(Sequential address traversal is too slow across fragmented sectors!)" next
    "@(I will demonstrate the Virtual Memory Page Translation vector <PSI Teleport>!)" next
    "@(To execute a far jump without raising a page fault," next
    "@you must build up speed across a contiguous linear address buffer to saturate the bus!)[03]"
    "{window_closeall}[1F F1 05 03 9E 02][1F 61][1F E6 05 03]{music(13)}[1F E9 05 03][1F 61][1F E6 05 03]{music_resume}[1F E9 05 03][1F 61][1F F1 05 03 08 00][19 23 05 03 01 FF 00][1F 16 05 03 00]{pause(30)}{window_open(1)}"
    "@Ukkie!" next
    "@(I translated pages to Fourside and returned instantly!)" next
    "@(Now allocate your own acceleration buffer and try it!){wait}{window_closeall}{set(flag 2)}"
    eob

cow_teleport_monkey_learn:
    "{window_open(1)}@{name(1)} compiled the PSI Teleportation translation vector into firmware!{wait}{window_closeall}{learnpsi(1, 1)}{set(flag 275)}[19 23 05 03 01 FF 00][1F 16 05 03 00][1F 1A 05 03 03]{pause(60)}[1F 1B 05 03][1F F1 05 03 80 02][1F 61]{window_open(1)}@Kyaho!" next
    "@(Virtual memory paging initialized! The teacher daemon is deallocating now!){wait}{window_closeall}[1F F1 05 03 9F 02]{unset(flag 2)}{unset(flag 615)}{unset(flag 613)}"
    eob
