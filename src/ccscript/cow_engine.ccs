// Reusable Engine Commands
command cow_touch(f) "{set(flag f)}"
command cow_clean(f) "{unset(flag f)}"
command cow_check(f) "{isset(flag f)}"

// Glitch and Sensory Dispatch Routines
command cow_pulse "{sound(11)}"
command cow_fault_sfx "{sound(18)}"
command cow_beam_sfx "{sound(97)}"

