command e(label) "{long label}"

// ==============================================================================
// EarthBound: Zero Fault - Phase 12: Fire Spring Thermal Runaway Scenario
// ==============================================================================
// Carbon Dog / Diamond Dog Thermal Runaway Daemon confrontation and 8th Sanctuary
// cache line synchronization.
// Sector 32 (flag 915), mutation flag 919.
// ==============================================================================

cow_firespring_boss:
    "[06 C5 00 {e(data_32.l_0xc7c588)}]{counter(1)}"
    call(data_33.l_0xc7dc7f)
    "[1B 03 {e(data_22.l_0xc690a6)}]{music(155)}"
    "@Thermal Runaway Alert at Sanctuary Cache Node 8!" next
    "@Silicon junction temperature exceeding rated tolerances." next
    "@I am the Thermal Runaway Daemon guarding the 8th Sanctuary cache line." next
    "@All unshielded threads will be melted into raw semiconductor slag...[03]"
    call(data_21.l_0xc6843a)
    "[1B 03 {e(data_21.l_0xc683de)}][1F 1E FC 04 08]{pause(120)}{set(flag 197)}{set(flag 919)}" eob

cow_firespring_melody:
    "[1F 15 6A 00 60 01 01]{unset(flag 2)}"
    call(data_33.l_0xc7dd6b)
    "{music(39)}"
    call(data_32.l_0xc7c54b)
    "{set(flag 2)}[1F 61]{counter(1)}"
    call(data_33.l_0xc7dc7f)
    "[1B 02 {e(cow_firespring_melody_record)}]{window_open(1)}"
    "@The power of Fire Spring..."
    call(data_32.l_0xc7c55d)
    goto(cow_firespring_melody_record)

cow_firespring_melody_record:
    "{set(flag 4)}"
    call(data_32.l_0xc7c57d)
    "{music_resume}[06 BD 00 {e(cow_firespring_melody_end)}]{window_open(1)}"
    "@{name(1)} had the sensation of watching an initial boot instance of himself.[03]{pause(60)}" linebreak
    "@{name(1)}'s Sound Stone synchronized the melody of the Fire Spring.{wait}{set(flag 189)}{window_closetop}"
    call(cow_engine.cow_fault_commit_firespring)
    goto(cow_firespring_melody_end)

cow_firespring_melody_end:
    call(data_53.l_0xc9b226)
    "[06 80 01 {e(cow_firespring_flag_548)}]"
    eob

cow_firespring_flag_548:
    "{set(flag 548)}" eob
