    "@When the heap corrupts" next
    "@Do not dereference null" next
    "@Flush the dirty cache." next
    "@This is my final request... Don't follow my stack trace." next
    "@I must deallocate..." next
    "@So... long!{wait}"
    "{set(flag 891)}{set(flag 145)}{unset(flag 60)}"
    call(data_40.l_0xc8983b)
    eob

cow_monotoli:
