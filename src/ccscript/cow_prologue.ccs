import "asm65816.ccs"

command e(label) "{long label}"

// ==============================================================================
// EarthBound: Zero Fault - Phase 18: Deconstructed Awakening & Prologue
// ==============================================================================
// 1. Silent Cold Open: Bypasses meteor explosion cutscene; Ness awakens in silence.
// 2. Bedroom Desk Drawer: Contains the Logic Probe (Item 138) and Worn Polarized Lens (Item 206).
// 3. Hallway Tracy: Discovers eerie silence and stopped time.
// ==============================================================================

// -----------------------------------------------------------------------------
// 1. Cold Open Sequence (Overrides 0xC5E70B)
// -----------------------------------------------------------------------------
cow_cold_open:
    "{music(0)}" // Silence audio engine completely
    "{set(flag 749)}" // Flag 749: Pajamas
    "{set(flag 476)}" // Flag 476: Ness is out of bed
    "{unset(flag 477)}" // Ensure bed sleeping sprites (NPC 26/27) are hidden
    "{unset(flag 469)}" // Ensure player sprite is visible
    "{warp(10)}" // Smooth fade-in directly to the bedroom floor beside the bed (tile 1015, 138)
    "{pause(40)}" // Brief moment of eerie silence as room fades in
    "{unset(flag 11)}{save}" eob

// -----------------------------------------------------------------------------
// 2. Bedroom Desk Drawer (Overrides 0xC8683D)
// -----------------------------------------------------------------------------
cow_desk_drawer:
    "[19 10 01]{swap}@{name(0)} opened the desk drawer." next
    "[06 F3 02 {e(cow_desk_empty)}]" // Check flag 755 (already taken)
    "@Buried beneath old school notes and worn stationery was a hardware diagnostic instrument." next
    "@A ring-0 Logic Probe..." next
    "@And beside it, a cracked polarized lens from a bus analyzer." next
    "@They shouldn't be here. Relics from prior loops that survived the reboot." next
    "[19 10 01]{swap}@There was a {itemname(138)} in the drawer." next
    "[1D 03 FF][1B 02 {e(cow_desk_full)}][1D 0E 00 8A]" call(data_33.l_0xc7dccf)
    "[19 10 01]{swap}@There was also a {itemname(206)} in the drawer." next
    "[1D 03 FF][1B 02 {e(cow_desk_full)}][1D 0E 00 CE]" call(data_33.l_0xc7dccf)
    "{set(flag 755)}" end

cow_desk_empty:
    "@The drawer is empty, save for yellowed lined paper." end

cow_desk_full:
    "@You don't have any room in your backpack." end

// -----------------------------------------------------------------------------
// 3. Hallway Tracy Awakening (Overrides 0xC66AA4)
// -----------------------------------------------------------------------------
cow_tracy_awakening:
    "[06 49 00 {e(data_28.l_0xc7625e)}]"
    "[06 B4 02 {e(data_20.l_0xc66bc0)}]"
    "[06 B5 02 {e(data_20.l_0xc66c7d)}]"
    "[06 78 02 {e(data_20.l_0xc66b33)}]"
    "[06 61 00 {e(data_28.l_0xc76112)}]"
    "[06 D6 01 {e(data_20.l_0xc66afe)}]"
    "@Hey, bro...{pause(20)} Did you feel that sudden stillness?" next
    "@The house is dead quiet... It feels like time just stopped moving." next
    "@Why are you looking at me like you haven't seen me in years?{wait}{set(flag 470)}" eob

// Wire Prologue hooks into ROM addresses
ROM[0xC5E70B] = goto(cow_cold_open)
ROM[0xC8683D] = goto(cow_desk_drawer)
ROM[0xC66AA4] = goto(cow_tracy_awakening)

// Initialize engine camera directly to Ness's bedroom floor (Camera X=8120, Camera Y=1104 = tile 1015, 138)
ROM[0xC1FE9A] = {
    LDA_i(0x1FB8)
    LDX_i(0x0450)
    JSL(0xC0B65F)
}

// Eliminate intro cutscene screen shake ($4A66 = 0) at 0xC1FEBC (6 bytes)
ROM[0xC1FEBC] = {
    STZ_a(0x4A66)
    NOP NOP NOP
}
