command e(label) "{long label}"

// ==============================================================================
// EarthBound: Zero Fault - Saturn Valley & Milky Well Sanctuary (P8-05)
// ==============================================================================
// Alien primitive types, Rootkit Sprout, and Milky Well cache line commit.
// ==============================================================================

cow_saturn_valley:
    "{font_saturn}[06 4A 00 {e(data_34.l_0xc7e890)}][06 47 00 {e(data_34.l_0xc7e86c)}]"
    "@We feel" linebreak
    "  system flow!" next
    "@Hi ho." linebreak
    "  Me" linebreak
    "  Mr. Saturn." next
    "@All instances" linebreak
    "  share one symbol!" next
    "@No private heap!" linebreak
    "  Pure primitive types!" next
    "@Zero mutable state!" linebreak
    "  Boing!{wait}{font_normal}" eob

cow_trillionage_sprout:
    "[06 C1 00 {e(data_32.l_0xc7c588)}]{counter(1)}" call(data_33.l_0xc7dc7f) "[1B 03 {e(data_22.l_0xc690a6)}]{music(155)}"
    "@Unauthorized thread detected at Sanctuary Node 3." next
    "@I am Rootkit Sprout. This cache line is locked under elevated root privileges." next
    "@Attempt permission override... if your debugger is capable![03]"
    call(data_21.l_0xc6841e)
    "[1B 03 {e(data_21.l_0xc683de)}][1F 1E C1 02 08]{pause(120)}{set(flag 193)}" eob

cow_milky_well_commit:
    "[1F 15 6A 00 60 01 01]{unset(flag 2)}"
    call(data_33.l_0xc7dd6b)
    "{music(35)}"
    call(data_32.l_0xc7c54b)
    "{set(flag 2)}[1F 61]{sound(11)}{sound(97)}"
    "{set(flag 866)}{set(flag 888)}"
    "{counter(1)}" call(data_33.l_0xc7dc7f) "[1B 02 {e(cow_milky_well_msg)}]"
    "{window_open(1)}@The resonant harmonic frequency of Milky Well synchronizes the third sanctuary cache..."
    goto(cow_milky_well_msg)

cow_milky_well_msg:
    call(data_32.l_0xc7c57d)
    "{set(flag 4)}{music_resume}"
    "{window_open(1)}@{name(1)} felt the pristine baseline waveform of the universe pulse through the Sound Stone.[03]{pause(60)}" linebreak
    "@Sector 17 cache line successfully committed to non-volatile flash memory!{wait}"
    "{set(flag 185)}{window_closetop}"
    goto(data_32.l_0xc7c1f7)

ROM[0xC7E819] = goto(cow_saturn_valley)
ROM[0xEF679A] = goto(cow_trillionage_sprout)
ROM[0xC7C12A] = goto(cow_milky_well_commit)
ROM[0xC7C17B] = goto(cow_milky_well_msg)
