command e(label) "{long label}"

// ==============================================================================
// EarthBound: Zero Fault - Phase 10: Sea of Serendipity & Kraken Scenario
// ==============================================================================
// Oceanic memory bus traversal, packet storm contention, and Kraken daemon
// purge.
// ==============================================================================

cow_sailor_captain:
    "[06 D9 00 {e(data_42.l_0xc8b851)}][06 10 00 {e(cow_sailor_ready)}][06 0A 00 {e(data_42.l_0xc8b64e)}]@Initiate oceanic memory bus traversal?" linebreak
    "[19 02]Yes[02][19 02]No[02][1C 07 02][11]{clearline}[09 02 {e(data_42.l_0xc8b57e)} {e(data_42.l_0xc8b568)}]"
    goto(data_42.l_0xc8b568)

cow_sailor_ready:
    "[06 2D 02 {e(cow_sailor_board)}]@Thank you!{pause(20)}" linebreak
    "  You cleared my wife's thread contention!" next
    "@She terminated that recursive loop at the Stoic Club!" next
    "@Let's allocate our packet stream!" next
    "{set(flag 557)}"
    goto(cow_sailor_board)

cow_sailor_board:
    "@If your thread stack is hardened, board this packet transport." next
    "@The unshielded oceanic bus experiences catastrophic latency and collision spikes!" next
    "@You will likely encounter the Packet Storm Kraken mid-transit!" next
    "@Do you wish to transmit your threads across the channel to Scaraba?" next
    goto(data_42.l_0xc8b77b)

cow_kraken_voyage:
    "{event(5)}{set(flag 11)}[1F F1 29 04 23 01][1F 15 6A 00 24 01 01]"
    call(data_53.l_0xc9b4b8)
    "{hide_char(255)}"
    call(data_33.l_0xc7dd6b)
    "{set(flag 542)}{music_resume}[1F F1 40 04 25 01][1F EE 40 04][1F E8 FF][1F 61][1F ED]{lock_movement(255)}{warp(89)}[1F 15 05 01 26 01 01]{pause(1)}[1F EF 05 01][1F E8 FF][1F 61][1F E7 05 01]"
    call(data_46.l_0xc92dee)
    "[1F EA 05 01][1F 61][1F 15 27 01 27 01 01][1F 61][1F E7 05 01][06 D9 00 {e(data_46.l_0xc92d92)}]{set(flag 543)}{unset(flag 542)}{window_open(1)}@CRITICAL BUS FAULT: The Packet Storm Kraken emerges from the channel!" next
    "{window_closeall}"
    call(data_21.l_0xc685ad)
    "[1B 03 {e(data_46.l_0xc92dde)}][1F F2 27 01 7B 02]{pause(60)}{window_open(1)}@Unbelievable!" next
    "@You purged the Packet Storm Kraken from the oceanic channel!" next
    "@Bus contention cleared! Channel bandwidth restored to Scaraba!{wait}{window_closeall}{pause(1)}"
    call(cow_engine.cow_fault_commit_sea)
    "{set(flag 903)}"
    goto(data_46.l_0xc92d92)
